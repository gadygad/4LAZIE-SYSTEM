{
  "manifest_version": 3,
  "name": "4LAZIE - Premium Student Portal",
  "version": "1.0",
  "description": "Search notes, past papers, and stay updated with 4LAZIE notifications straight from your browser.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "4LAZIE Quick Search",
    "default_icon": "icons/icon128.png"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://*.up.railway.app/*",
    "http://localhost:8080/*"
  ]
}
